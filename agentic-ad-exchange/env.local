# ============================================================================
# Agentic Ad Exchange Stack — environment variables
# ============================================================================
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# Generate a 32-byte entity secret with: pnpm --filter @ade/scripts generate:entity-secret
# ============================================================================

# --- Circle ------------------------------------------------------------------
CIRCLE_API_KEY="TEST_API_KEY:a8f1cf36ec41d708514b915dbd204430:483227b63a6ab2530e1bdba408d055b3"
# CIRCLE_ENTITY_SECRET will be generated here
CIRCLE_ENVIRONMENT=testnet     # "testnet" | "mainnet" — mainnet forbidden until submission

# --- Arc (settlement chain) --------------------------------------------------
ARC_CHAIN_ID=5042002           # Arc testnet EVM chain ID — https://docs.arc.network/arc/references/network-information
ARC_RPC_URL="https://rpc.testnet.arc.network"

# --- Agent LLM ---------------------------------------------------------------
# Google Gemini API direct — the only LLM transport for the buyer + seller agents.
GEMINI_API_KEY=AIzaSyB67dFpv_4DxXx75PAYiFysWo_Q7K71yso                # From aistudio.google.com or Cloud Console
GEMINI_MODEL=gemini-2.5-flash  # Direct Gemini model id

# --- Exchange server ---------------------------------------------------------
PORT=4021                      # Exchange server port
NODE_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173  # Comma-separated allow-list; never "*"
BID_RATE_LIMIT_PER_MIN=120     # Per-wallet rate limit on POST /bid
ASSISTANT_CHAT_RATE_LIMIT_PER_MIN=30  # IP-keyed limit on POST /assistant/chat
# Set to 1 or true in development only — loads fake listings/bids/settlements + replays auction feed on SSE connect (forbidden with NODE_ENV=production)
# UI_FIXTURE_SEED=1

# --- Scripts & demo wallets --------------------------------------------------
WALLET_SET_ID=3b5cdab4-1967-5929-9dda-9c46d818265b
BUYER_WALLET_ID=66fc84c1-812f-5cbe-8c45-6af26967c54a
BUYER_WALLET_ADDRESS=0xabcfc4790c89ecb0d8e32e5ff2d14f92f1c31ec9
SELLER_WALLET_ID=2af5b7bb-4153-5c83-a372-4eaa13261ff9
SELLER_WALLET_ADDRESS=0x5d01c1f0abe271f94efae9911ba404ace99e1197
MARKETPLACE_WALLET_ADDRESS=0x5d01c1f0abe271f94efae9911ba404ace99e1197
DEPOSIT_AMOUNT_USDC=0.10       # One-time Gateway deposit (matches nanopayments tutorial)
DEPOSIT_TIMEOUT_MS=1500000     # 25 min default — Circle testnet credits in 13–19 min
DEMO_LOAD_CYCLES=50            # Min 50 — hackathon ≥ 50 on-chain tx gate

# EOA address that receives x402 Gateway payouts (can be same as SELLER_WALLET_ADDRESS)
SELLER_EOA_ADDRESS=

# --- Agents ------------------------------------------------------------------
EXCHANGE_API_URL=http://localhost:4021  # Where agents reach the Exchange

# --- Multi-agent demo personas ----------------------------------------------
# Required for POST /demo/agent-run ("✨ Run Multi-Agent Auction (Gemini)").
# Each persona needs BOTH the Circle wallet id AND the on-chain address.
# Provision via scripts/createWallets, then paste the values below. A persona
# with only one of the two is silently skipped; if all three end up empty the
# demo route returns 503 demo_not_configured.
BUYER_LUXURYCO_WALLET_ID=66fc84c1-812f-5cbe-8c45-6af26967c54a
BUYER_LUXURYCO_WALLET_ADDRESS=0xabcfc4790c89ecb0d8e32e5ff2d14f92f1c31ec9
BUYER_GROWTHCO_WALLET_ID=66fc84c1-812f-5cbe-8c45-6af26967c54a
BUYER_GROWTHCO_WALLET_ADDRESS=0xabcfc4790c89ecb0d8e32e5ff2d14f92f1c31ec9
BUYER_RETAILCO_WALLET_ID=66fc84c1-812f-5cbe-8c45-6af26967c54a
BUYER_RETAILCO_WALLET_ADDRESS=0xabcfc4790c89ecb0d8e32e5ff2d14f92f1c31ec9

# --- UI ---------------------------------------------------------------------
# UI env vars MUST NOT contain secrets. VITE_*/NEXT_PUBLIC_* are bundle-visible.
VITE_API_BASE_URL=/api
VITE_SELLER_WALLET_ADDRESS=0x5d01c1f0abe271f94efae9911ba404ace99e1197
VITE_SELLER_API_BASE_URL=      # Optional override for the seller chat backend. Blank → falls back to VITE_API_BASE_URL.

# --- x402 Gateway & buyer EIP-3009 signer -----------------------------------
# Server-side only. NEVER in ui/.env.example.
X402_NETWORK=eip155:5042002                           # CAIP-2 form of ARC_CHAIN_ID — used by x402-batching
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com  # Circle Gateway facilitator (testnet default)
BUYER_CHAIN=arcTestnet                                # x402-batching chain key (GatewayClient)
BUYER_PRIVATE_KEY="0xaeaad18fc151a40dc2b5de97a8b09d997bc528e9df15387e632bae5d9114f3f5"

# --- Railway agent-service overrides ----------------------------------------
# These vars are used by the standalone @ade/agent-buyer and @ade/agent-seller
# services on Railway (one process per persona). Local `pnpm dev` ignores them
# unless you actually run the run.ts loops. See README "Deploy to Railway".

# Server: switch to "external" in production so the in-server demo router
# stops mounting and standalone agent services own auction generation. Default
# "in_process" preserves existing local-dev behavior (POST /demo/agent-run).
DEMO_MODE=in_process

# Buyer agent service (set on each Railway buyer replica — one per persona).
# BUYER_WALLET_ADDRESS must match one of BUYER_LUXURYCO/GROWTHCO/RETAILCO_WALLET_ADDRESS
# on the server, otherwise settlement falls back to BUYER_WALLET_ID and persona
# attribution is lost.
BUYER_AGENT_ID=                # e.g. buyer-luxuryco
BUYER_AGENT_BRAND=             # e.g. "LuxuryCo (premium fashion brand awareness)"
BUYER_AGENT_STRATEGY=          # one-line strategy summary for the LLM
BUYER_AGENT_MAX_BID_USDC=      # decimal string, e.g. 0.009
BUYER_AGENT_MIN_BID_USDC=      # decimal string, e.g. 0.003
BUYER_AGENT_PREFERRED_TAGS=    # comma-separated, e.g. luxury,fashion,premium
BUYER_POLL_INTERVAL_MS=1000    # poll cadence (default 1 Hz)

# Seller agent service.
SELLER_LISTING_INTERVAL_MS=30000  # cadence for new listing registrations





CIRCLE_ENTITY_SECRET=4b978ccf1a63325d704267ad5ad9e2783cbc2864f720018a6f6b63cff5c80c62
